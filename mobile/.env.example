# Copy this file to .env and fill in the values. Never commit .env.
# These are the SAME Supabase project values as the website (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY).
# Expo puts every EXPO_PUBLIC_ variable inside the app, so ONLY public values may use this prefix.
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The live website — product images are loaded from it (public value)
EXPO_PUBLIC_WEBSITE_URL=https://minds-matter-ecommerce.vercel.app
