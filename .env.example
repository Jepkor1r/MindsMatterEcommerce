# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# IMPORTANT: Vite copies every variable starting with VITE_ into the public
# JavaScript bundle, so anyone visiting the site can read it.
# Only PUBLIC values may use the VITE_ prefix.

# ── Public (safe in the browser) ──
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Google OAuth (Phase 4) ──
# Nothing goes here. The Google Client ID and Client Secret are stored in the
# Supabase dashboard (Authentication → Sign In / Providers → Google) only.

# ── SERVER-ONLY secrets (never prefix with VITE_) ──
# These will be used by server-side functions in later phases and set in the
# hosting provider's environment settings, not in the browser.

# SUPABASE_SERVICE_ROLE_KEY=

# Mailgun (Phase 6) — set in Supabase → Edge Functions → Secrets, NOT in .env.local
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM_EMAIL=
# MAILGUN_API_BASE=          (optional; only needed for EU accounts: https://api.eu.mailgun.net)
# SITE_URL=                  (website address used for the "View your order" link)
# STORE_CONTACT_EMAIL=       (optional; customer contact / reply-to address)

# M-Pesa Daraja (Phase 7)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=

# International payment provider (Phase 7)
# INTERNATIONAL_PAYMENT_SECRET=
# INTERNATIONAL_PAYMENT_PUBLIC_KEY=
# INTERNATIONAL_PAYMENT_WEBHOOK_SECRET=
